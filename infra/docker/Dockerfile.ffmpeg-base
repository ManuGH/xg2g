# Reusable FFmpeg runtime base image for local and CI iteration.
# Build once, then point Dockerfile's FFMPEG_BASE_IMAGE at the resulting tag.

FROM debian:trixie-slim AS ffmpeg-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    git \
    yasm \
    nasm \
    pkg-config \
    libx264-dev \
    libx265-dev \
    libdav1d-dev \
    libva-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY backend/scripts/build-ffmpeg.sh .
ENV TARGET_DIR=/opt/ffmpeg
# Debug symbols are split out here and kept OUT of the runtime image below.
ENV DEBUG_DIR=/opt/ffmpeg-debug
RUN ./build-ffmpeg.sh

# Symbols-only stage. Nothing depends on it, so a normal build never pays for it;
# export it when a core needs reading, keyed to the same build as the image:
#
#   docker build -f infra/docker/Dockerfile.ffmpeg-base --target ffmpeg-debug \
#     --output type=local,dest=./ffmpeg-debug .
#
# Without this, an ffmpeg fault leaves a core nobody can attribute to a function —
# which is exactly what six cores on the staging box turned out to be.
FROM scratch AS ffmpeg-debug
COPY --from=ffmpeg-builder /opt/ffmpeg-debug /

FROM debian:trixie-slim AS ffmpeg-runtime-base

ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    XG2G_LISTEN=":8088" \
    FFMPEG_HOME="/opt/ffmpeg" \
    XG2G_FFMPEG_BIN="/usr/local/bin/ffmpeg" \
    XG2G_FFPROBE_BIN="/usr/local/bin/ffprobe"

# Intel's iHD userspace is only shipped for x86_64-class Debian targets. Keep the
# runtime truth explicit: amd64 gets Intel + Mesa VAAPI drivers; arm64 gets the
# generic VAAPI libs and Mesa path without pretending Intel userspace exists there.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    mesa-va-drivers \
    libva-drm2 \
    libva2 \
    libx264-164 \
    libx265-215 \
    libdav1d7 \
    && if [ "${TARGETARCH}" = "amd64" ]; then \
        apt-get install -y --no-install-recommends intel-media-va-driver; \
      fi \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 xg2g && \
    useradd -u 10001 -g xg2g -m -s /sbin/nologin xg2g && \
    (getent group video || groupadd -g 44 video) && \
    usermod -aG video xg2g && \
    mkdir -p /var/lib/xg2g/recordings /var/lib/xg2g/tmp /var/lib/xg2g/sessions /etc/xg2g && \
    chown -R 10001:10001 /var/lib/xg2g /etc/xg2g

COPY --from=ffmpeg-builder --chown=root:root /opt/ffmpeg /opt/ffmpeg
COPY --chown=root:root backend/scripts/ffmpeg-wrapper.sh /usr/local/bin/ffmpeg
COPY --chown=root:root backend/scripts/ffprobe-wrapper.sh /usr/local/bin/ffprobe
RUN chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

LABEL org.opencontainers.image.title="xg2g-ffmpeg-base" \
    org.opencontainers.image.description="Reusable FFmpeg runtime base for xg2g container builds" \
    org.opencontainers.image.licenses="PolyForm-Noncommercial-1.0.0"

USER 10001:10001
