{
  "name": "webui",
  "private": true,
  "version": "3.5.1",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "generate-client": "openapi-ts --input ../../backend/api/openapi.yaml --output ./src/client-ts && node ../../backend/scripts/stamp-client-ts-marker.mjs",
    "design:check": "bash scripts/verify-no-hardcoded-colors.sh && bash scripts/verify-motion-contract.sh && bash scripts/verify-no-window-dialogs.sh && bash scripts/verify-no-btn-classes.sh",
    "gate:no-appledouble": "node scripts/no-appledouble.mjs",
    "gate:no-duration-guessing": "node scripts/no-duration-guessing.mjs",
    "gate:no-raw-json-fetch": "node scripts/no-raw-json-fetch.mjs",
    "gate:no-raw-error-text": "node scripts/no-raw-error-text.mjs",
    "gate:no-client-decision-engine": "node scripts/no-client-decision-engine.mjs",
    "gate:no-ua-sniffing": "node scripts/no-ua-sniffing.mjs",
    "gate:no-seek-resume-guessing": "node scripts/no-seek-resume-guessing.mjs",
    "verify:client-wrapper": "bash scripts/verify-client-wrapper-boundary.sh",
    "gate:seekable-contract": "vitest run tests/contracts/v3player.seekable-gate.test.tsx",
    "gate:mode-bridge": "vitest run tests/contracts/v3player.mode-bridge.test.ts",
    "gate:no-dead-css:player": "node scripts/css-dead-inventory.mjs src/features/player/components/V3Player.module.css src",
    "gate:no-dead-css:all": "node scripts/css-dead-inventory.mjs \"src/**/*.module.css\" src",
    "lint": "eslint . && bash ../../backend/scripts/ci_gate_webui_logging.sh && npm run design:check && npm run gate:no-dead-css:player",
    "preview": "vite preview",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tanstack/react-query": "^5.102.3",
    "hls.js": "^1.7.1",
    "i18next": "^26.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.12",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18"
  }
}
